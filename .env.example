# ==== Shop / Admin ====
# Admin login credentials (change these!). Password is hashed on first run if plain text is detected.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Secret used to sign admin session tokens (use a long random string in production)
JWT_SECRET=replace-with-a-long-random-secret

# ==== WhatsApp ====
# Shop WhatsApp number in international format, no + or spaces, e.g. 919876543210
NEXT_PUBLIC_SHOP_WHATSAPP_NUMBER=SHOP_WHATSAPP_NUMBER

# ==== Maps (optional, phase 2) ====
# If you later add a map preview (e.g. Google Maps / Mapbox), put the key here.
NEXT_PUBLIC_MAPS_API_KEY=

# ==== Payments (optional, phase 2) ====
# Razorpay keys, added later when online payment is enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
